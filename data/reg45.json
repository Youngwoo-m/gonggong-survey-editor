ef": null, "history": [], "children": []}, {"id": "a66", "level": "조", "no": 44, "branch": 4, "title": "", "body": "삭제 <2010.3.22>", "status": "유지", "legacyNo": "제44조의4", "reason": "", "sourceRef": null, "history": [], "children": []}, {"id": "a67", "level": "조", "no": 44, "branch": 5, "title": "", "body": "삭제 <2009.3.13>", "status": "유지", "legacyNo": "제44조의5", "reason": "", "sourceRef": null, "history": [], "children": []}, {"id": "a68", "level": "조", "no": 44, "branch": 6, "title": "", "body": "삭제 <2009.3.13>", "status": "유지", "legacyNo": "제44조의6", "reason": "", "sourceRef": null, "history": [], "children": []}, {"id": "a69", "level": "조", "no": 44, "branch": 7, "title": "", "body": "삭제 <2010.3.22>", "status": "유지", "legacyNo": "제44조의7", "reason": "", "sourceRef": null, "history": [], "children": []}, {"id": "a70", "level": "조", "no": 44, "branch": 8, "title": "", "body": "삭제 <2010.3.22>", "status": "유지", "legacyNo": "제44조의8", "reason": "", "sourceRef": null, "history": [], "children": []}]}, {"id": "h71", "level": "장", "no": 7, "branch": 0, "title": "보칙", "body": "", "status": "유지", "legacyNo": "", "reason": "", "sourceRef": null, "history": [], "children": [{"id": "a72", "level": "조", "no": 45, "branch": 0, "title": "", "body": "삭제 <2010.3.22>", "status": "유지", "legacyNo": "제45조", "reason": "", "sourceRef": null, "history": [], "children": []}, {"id": "a73", "level": "조", "no": 45, "branch": 2, "title": "", "body": "삭제 <2010.7.23>", "status": "유지", "legacyNo": "제45조의2", "reason": "", "sourceRef": null, "history": [], "children": []}, {"id": "a74", "level": "조", "no": 46, "branch": 0, "title": "권한의 위임ㆍ위탁", "body": "① 이 법에 따른 과학기술정보통신부장관의 권한은 그 일부를 대통령령으로 정하는 바에 따라 소속기관의 장 또는 지방우정청장에게 위임ㆍ위탁할 수 있다. <개정 2013.3.23, 2017.7.26>\n② 삭제 <2010.3.22>", "status": "유지", "legacyNo": "제46조", "reason": "", "sourceRef": null, "history": [], "children": []}]}, {"id": "h75", "level": "장", "no": 8, "branch": 0, "title": "벌칙", "body": "", "status": "유지", "legacyNo": "", "reason": "", "sourceRef": null, "history": [], "children": [{"id": "a76", "level": "조", "no": 47, "branch": 0, "title": "벌칙", "body": "① 삭제 <2015.12.22>\n②자기 또는 타인에게 이익을 주거나 타인에게 손해를 가할 목적으로 전기통신설비에 의하여 공연히 허위의 통신을 한 자는 3년이하의 징역 또는 3천만원이하의 벌금에 처한다. <개정 1996.12.30>\n③제2항의 경우에 그 허위의 통신이 전신환에 관한 것인 때에는 5년 이하의 징역 또는 5천만원 이하의 벌금에 처한다. <개정 1996.12.30>\n④ 전기통신업무에 종사하는 사람이 제3항의 행위를 한 때에는 10년 이하의 징역 또는 1억원 이하의 벌금에 처하고, 제2항의 행위를 한 때에는 5년 이하의 징역 또는 5천만원 이하의 벌금에 처한다. <개정 2015.12.22>", "status": "유지", "legacyNo": "제47조", "reason": "", "sourceRef": null, "history": [], "children": []}, {"id": "a77", "level": "조", "no": 48, "branch": 0, "title": "", "body": "삭제 <2010.7.23>", "status": "유지", "legacyNo": "제48조", "reason": "", "sourceRef": null, "history": [], "children": []}, {"id": "a78", "level": "조", "no": 48, "branch": 2, "title": "", "body": "삭제 <2001.1.16>", "status": "유지", "legacyNo": "제48조의2", "reason": "", "sourceRef": null, "history": [], "children": []}, {"id": "a79", "level": "조", "no": 49, "branch": 0, "title": "", "body": "삭제 <2010.7.23>", "status": "유지", "legacyNo": "제49조", "reason": "", "sourceRef": null, "history": [], "children": []}, {"id": "a80", "level": "조", "no": 50, "branch": 0, "title": "", "body": "삭제 <2000.1.28>", "status": "유지", "legacyNo": "제50조", "reason": "", "sourceRef": null, "history": [], "children": []}, {"id": "a81", "level": "조", "no": 51, "branch": 0, "title": "", "body": "삭제 <2010.7.23>", "status": "유지", "legacyNo": "제51조", "reason": "", "sourceRef": null, "history": [], "children": []}, {"id": "a82", "level": "조", "no": 52, "branch": 0, "title": "", "body": "삭제 <2010.7.23>", "status": "유지", "legacyNo": "제52조", "reason": "", "sourceRef": null, "history": [], "children": []}, {"id": "a83", "level": "조", "no": 53, "branch": 0, "title": "", "body": "삭제 <2010.7.23>", "status": "유지", "legacyNo": "제53조", "reason": "", "sourceRef": null, "history": [], "children": []}]}], "docFile": "data/원문/reg45/전기통신기본법(법률)(제16019호)(20190625).hwpx", "docFiles": ["data/원문/reg45/전기통신기본법(법률)(제16019호)(20190625).hwpx", "data/원문/reg45/전기통신기본법(법률)(제16019호)(20190625).pdf"]}