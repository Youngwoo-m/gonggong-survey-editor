<?xml version="1.0" encoding="UTF-8"?>
<table id="loc11t0028" article="제50조(레벨 등에 따른 수준측량의 방식)" rows="4" cols="2" source="作業規程の準則 (일본 국토지리원 2025)">
  <row>
    <cell col="0" row="0" header="1">측 량 방 법</cell>
    <cell col="1" row="0" header="1">관 측 거 리</cell>
  </row>
  <row>
    <cell col="0" row="1">교 호 법</cell>
    <cell col="1" row="1">1급수준측량은 약 300m 이하로 한다. 2~4급수준측량은 약 450m 이하로 한다.</cell>
  </row>
  <row>
    <cell col="0" row="2">경 위 의 법</cell>
    <cell col="1" row="2">1~4급수준측량은 약 1km 이하로 한다.</cell>
  </row>
  <row>
    <cell col="0" row="3">부 앙 나 사 법</cell>
    <cell col="1" row="3">1~4급수준측량은 약 2km 이하로 한다.</cell>
  </row>
</table>