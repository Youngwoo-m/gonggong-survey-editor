<table id="loc11t0011" article="제39조(편심요소의 측정)" rows="4" cols="4" source="作業規程の準則 (일본 국토지리원 2025)">
  <row>
    <cell col="0" row="0" header="1">편심거리</cell>
    <cell col="1" row="0" header="1">기기 및 측정방법</cell>
