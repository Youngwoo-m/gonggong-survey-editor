  <text>2. 최저 심사비</text>
  <table rows="5" cols="3">
    <row>
      <cell col="0" row="0" header="1">측량의 종류</cell>
      <cell col="1" row="0" header="1">성과심사 단위</cell>
      <cell col="2" row="0" header="1">최저 심사비</cell>
